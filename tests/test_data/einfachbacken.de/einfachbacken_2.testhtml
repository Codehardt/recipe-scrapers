\"},{\"stepId\":21504,\"prefix\":null,\"quantity\":2,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":4351,\"name\":\"EL\",\"pluralName\":\"EL\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"22d64347-04a4-41f6-945a-9401e45a6e77\",\"id\":5331,\"name\":\"Chia-Samen\",\"pluralName\":\"Chia-Samen\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":21504,\"prefix\":null,\"quantity\":1,\"quantityEnd\":null,\"suffix\":null,\"unit\":null,\"ingredient\":{\"uuid\":\"5a3a7e7c-9ed6-4b61-85eb-c66959ed13df\",\"id\":7216,\"name\":\"Kiwi\",\"pluralName\":\"Kiwis\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":21504,\"prefix\":null,\"quantity\":1,\"quantityEnd\":null,\"suffix\":null,\"unit\":null,\"ingredient\":{\"uuid\":\"0386619c-9a88-4b04-976b-b4ba1796e5d9\",\"id\":8016,\"name\":\"Maracuja\",\"pluralName\":\"Maracujas\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"}]}],\"content\":[{\"__typename\":\"ParagraphRecipeStep\",\"id\":21495,\"image\":{\"src\":\"https://www.einfachbacken.de/sites/einfachbacken.de/files/2019-08/mango_smoothie_bowl_26961.jpg\",\"width\":2048,\"name\":\"Mango-Smoothie-Bowl\",\"source\":\"einfach backen\",\"height\":1536,\"alt\":\"Mango-Smoothie-Bowl\",\"description\":null,\"copyright\":\"Brigitte Sporrer\",\"digitalSourceType\":null,\"title\":\"Mango-Smoothie-Bowl\",\"__typename\":\"MediaImage\",\"desktop\":{\"src\":\"https://www.einfachbacken.de/sites/einfachbacken.de/files/styles/700_530/public/2019-08/mango_smoothie_bowl_26961.jpg?h=4521fff0\u0026itok=H4-VP1kr\",\"width\":700,\"height\":530,\"__typename\":\"ImageDerivative\"},\"desktop_2x\":{\"src\":\"https://www.einfachbacken.de/sites/einfachbacken.de/files/styles/1400_1060/public/2019-08/mango_smoothie_bowl_26961.jpg?h=4521fff0\u0026itok=W8E6PSZb\",\"width\":1400,\"height\":1060,\"__typename\":\"ImageDerivative\"},\"tablet\":{\"src\":\"https://www.einfachbacken.de/sites/einfachbacken.de/files/styles/973_730/public/2019-08/mango_smoothie_bowl_26961.jpg?h=4521fff0\u0026itok=LzARERxG\",\"width\":973,\"height\":730,\"__typename\":\"ImageDerivative\"},\"tablet_2x\":{\"src\":\"https://www.einfachbacken.de/sites/einfachbacken.de/files/styles/1946_1460/public/2019-08/mango_smoothie_bowl_26961.jpg?h=4521fff0\u0026itok=i9HNfcEO\",\"width\":1946,\"height\":1460,\"__typename\":\"ImageDerivative\"},\"mobile\":{\"src\":\"https://www.einfachbacken.de/sites/einfachbacken.de/files/styles/576_432/public/2019-08/mango_smoothie_bowl_26961.jpg?h=4521fff0\u0026itok=YNHM8rda\",\"width\":576,\"height\":432,\"__typename\":\"ImageDerivative\"},\"mobile_2x\":{\"src\":\"https://www.einfachbacken.de/sites/einfachbacken.de/files/styles/1152_864/public/2019-08/mango_smoothie_bowl_26961.jpg?h=4521fff0\u0026itok=vwvf2YRl\",\"width\":1152,\"height\":864,\"__typename\":\"ImageDerivative\"}},\"ingredients\":[{\"stepId\":21495,\"prefix\":null,\"quantity\":2,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":4351,\"name\":\"EL\",\"pluralName\":\"EL\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"d1c1d47a-31b5-45d3-b79f-ccd68116ee0a\",\"id\":7296,\"name\":\"Kokoschip\",\"pluralName\":\"Kokoschips\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":21495,\"prefix\":null,\"quantity\":300,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":4371,\"name\":\"g\",\"pluralName\":\"g\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"792c498f-f0d0-4152-9df5-ff5a00e80c4c\",\"id\":7991,\"name\":\"Mango\",\"pluralName\":\"Mangos\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":21495,\"prefix\":null,\"quantity\":1,\"quantityEnd\":null,\"suffix\":null,\"unit\":null,\"ingredient\":{\"uuid\":\"00fadc30-884d-4fc9-b8b6-d7222d032354\",\"id\":4776,\"name\":\"Banane\",\"pluralName\":\"Bananen\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"}],\"text\":\"\u003cp\u003e\u003cspan\u003e\u003cspan\u003eKokoschips in einer Pfanne ohne Fett anrösten, auf einem Küchenpapier abkühlen lassen.\u0026nbsp;\u003c/span\u003e\u003c/span\u003e\u003cspan\u003e\u003cspan\u003eMango mit einem Sparschäler schälen und links und rechts entlang des großen Kerns das Fruchtfleisch wegschneiden. Übrige Mango von dem Kern schneiden. Alternativ gibt es mittlerweile auch Mango aus dem Tiefkühlregal. Banane schälen und in Scheiben schneiden.\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"},{\"__typename\":\"ParagraphRecipeStep\",\"id\":21498,\"image\":null,\"ingredients\":[{\"stepId\":21498,\"prefix\":null,\"quantity\":200,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":4371,\"name\":\"g\",\"pluralName\":\"g\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"f2279cff-7864-41a5-a7bd-2950e9866737\",\"id\":10191,\"name\":\"Sojajoghurt\",\"pluralName\":\"Sojajoghurt\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"}],\"text\":\"\u003cp\u003e\u003cspan\u003e\u003cspan\u003e¼ der Mango in kleine Würfel schneiden und zum Garnieren beiseite stellen.\u0026nbsp;\u003c/span\u003e\u003c/span\u003e\u003cspan\u003e\u003cspan\u003eRestliche Mango, Banane und Sojajoghurt\u0026nbsp;fein pürieren. Für heiße Tage kannst du\u0026nbsp;die Früchte gerne vorher einfrieren.\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"},{\"__typename\":\"ParagraphRecipeStep\",\"id\":21501,\"image\":null,\"ingredients\":[{\"stepId\":21501,\"prefix\":null,\"quantity\":1,\"quantityEnd\":null,\"suffix\":null,\"unit\":null,\"ingredient\":{\"uuid\":\"5a3a7e7c-9ed6-4b61-85eb-c66959ed13df\",\"id\":7216,\"name\":\"Kiwi\",\"pluralName\":\"Kiwis\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":21501,\"prefix\":null,\"quantity\":2,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":4351,\"name\":\"EL\",\"pluralName\":\"EL\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"22d64347-04a4-41f6-945a-9401e45a6e77\",\"id\":5331,\"name\":\"Chia-Samen\",\"pluralName\":\"Chia-Samen\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":21501,\"prefix\":null,\"quantity\":1,\"quantityEnd\":null,\"suffix\":null,\"unit\":null,\"ingredient\":{\"uuid\":\"0386619c-9a88-4b04-976b-b4ba1796e5d9\",\"id\":8016,\"name\":\"Maracuja\",\"pluralName\":\"Maracujas\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"}],\"text\":\"\u003cp\u003e\u003cspan\u003e\u003cspan\u003ePüree gleichmäßig auf zwei Schüsseln (ca. 250 ml) verteilen. Kiwi schälen, halbieren und in Scheiben schneiden. Kurz vor dem Servieren mit den beiseite gestellten Mangowürfeln, Kiwi, Kokoschips und je 1 EL Chiasamen garnieren. Eine Maracuja halbieren und mit einem Teelöffel das Fruchtfleisch direkt auf die Bowl verteilen. \u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"}],\"aufmacherVideo\":null,\"campaign\":null,\"topicTags\":[{\"topic\":{\"name\":\"Rezepte\",\"__typename\":\"TermTopic\"},\"page\":{\"url\":\"/rezeptsammlungen/backrezepte-131\",\"__typename\":\"NodeTopicPage\"},\"topicUrl\":\"\",\"__typename\":\"TermTopicPageMapping\"},{\"topic\":{\"name\":\"Brunch\",\"__typename\":\"TermTopic\"},\"page\":{\"url\":\"/rezeptsammlungen/brunch-ideen-6458\",\"__typename\":\"NodeTopicPage\"},\"topicUrl\":\"\",\"__typename\":\"TermTopicPageMapping\"},{\"topic\":{\"name\":\"Sommer\",\"__typename\":\"TermTopic\"},\"page\":{\"url\":\"/rezeptsammlungen/sommer-1011\",\"__typename\":\"NodeTopicPage\"},\"topicUrl\":\"\",\"__typename\":\"TermTopicPageMapping\"}],\"relatedRecipes\":{\"items\":[{\"id\":7693,\"name\":\"Kommunion-Torte\",\"url\":\"/rezepte/kommunion-torte\",\"kicker\":\"festlich\",\"introText\":\"Mit meiner Kommunion-Torte wird die Erstkommunion zum schönsten Fest. Die Tortendeko aus Buttercreme und Fondant kannst du ganz einfach selber machen. So musst du keine teure Torte bestellen.\",\"teaserText\":null,\"primaryTopic\":{\"name\":\"Kommunion \u0026 K
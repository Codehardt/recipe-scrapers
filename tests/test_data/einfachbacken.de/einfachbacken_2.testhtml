1/Anna_Lena_Zwar_64785.jpg?itok=AEbSHmUu\",\"width\":50,\"height\":50,\"__typename\":\"ImageDerivative\"}},\"url\":\"/autoren/anna-lena-zwar\",\"__typename\":\"NodeAuthorProfile\"},\"showEatbetterBranding\":false,\"numberPortions\":1,\"__typename\":\"NodeRecipe\"},{\"id\":7308,\"name\":\"Schoko-Beeren-Kuchen\",\"url\":\"/rezepte/beeren-schoko-kuchen\",\"kicker\":\"himmlisch\",\"introText\":\"Schoko-Beeren-Kuchen vereint unsere liebsten Zutaten: Schokolade und fruchtige Beeren. Mit meinem Rezept gelingt dir diese Traumkombi ganz einfach.\",\"teaserText\":null,\"primaryTopic\":{\"name\":\"Schokokuchen\",\"__typename\":\"TermTopic\"},\"secondaryTopics\":[{\"name\":\"Rezepte\",\"__typename\":\"TermTopic\"},{\"name\":\"Kuchen\",\"__typename\":\"TermTopic\"},{\"name\":\"Saison\",\"__typename\":\"TermTopic\"},{\"name\":\"Sommer\",\"__typename\":\"TermTopic\"},{\"name\":\"Preiselbeeren\",\"__typename\":\"TermTopic\"},{\"name\":\"Blaubeer-Rezepte\",\"__typename\":\"TermTopic\"},{\"name\":\"Himbeeren\",\"__typename\":\"TermTopic\"},{\"name\":\"Brombeer-Rezepte\",\"__typename\":\"TermTopic\"},{\"name\":\"Stachelbeeren\",\"__typename\":\"TermTopic\"},{\"name\":\"Johannisbeer-Rezepte\",\"__typename\":\"TermTopic\"},{\"name\":\"Heidelbeer-Rezepte\",\"__typename\":\"TermTopic\"},{\"name\":\"Frühling\",\"__typename\":\"TermTopic\"},{\"name\":\"Erdbeer-Rezepte\",\"__typename\":\"TermTopic\"},{\"name\":\"Herbst\",\"__typename\":\"TermTopic\"},{\"name\":\"Anlässe\",\"__typename\":\"TermTopic\"},{\"name\":\"Einschulung\",\"__typename\":\"TermTopic\"},{\"name\":\"Kindergeburtstag\",\"__typename\":\"TermTopic\"},{\"name\":\"Brunch\",\"__typename\":\"TermTopic\"},{\"name\":\"Muttertag\",\"__typename\":\"TermTopic\"},{\"name\":\"Valentinstag\",\"__typename\":\"TermTopic\"},{\"name\":\"Geburtstag\",\"__typename\":\"TermTopic\"},{\"name\":\"Obstkuchen\",\"__typename\":\"TermTopic\"}],\"image\":null,\"aufmacher\":{\"image\":{\"src\":\"https://www.einfachbacken.de/sites/einfachbacken.de/files/
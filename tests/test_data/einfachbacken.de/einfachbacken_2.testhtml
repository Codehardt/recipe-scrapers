t_value\":\"soy-free\",\"lang_value\":\"sojafrei\",\"value\":false},\"vegan\":{\"const_value\":\"vegan\",\"lang_value\":\"vegan\",\"value\":false},\"vegetarisch\":{\"const_value\":\"vegetarian\",\"lang_value\":\"vegetarisch\",\"value\":true},\"weizenfrei\":{\"const_value\":\"wheat-free\",\"lang_value\":\"weizenfrei\",\"value\":false}}}}"])</script><script>self.__next_f.push([1,"2e:T11f4,"])</script><script>self.__next_f.push([1,"\u003cscript type=\"application/ld+json\"\u003e{\n    \"@context\": \"https://schema.org\",\n    \"@graph\": [\n        {\n            \"@type\": \"Recipe\",\n            \"name\": \"Mango-Smoothie-Bowl – frisch \u0026 gesund frühstücken\",\n            \"description\": \"So wird es schon beim Frühstück fruchtig und gesund! Frische Mango, cremiger Sojajoghurt und Chia-Samen sorgen für den perfekten Start in den Tag.\",\n            \"keywords\": \"Rezepte,Anlässe,Brunch,Saison,Sommer,Kokoschip,Mango,Banane,Sojajoghurt,Kiwi,Chia-Samen,Maracuja\",\n            \"recipeYield\": \"2 Portion\",\n            \"recipeCuisine\": \"deutsche Rezepte\",\n            \"prepTime\": \"PT0M\",\n            \"datePublished\": \"2022-08-10T09:16:54+02:00\",\n            \"dateModified\": \"2026-10-19T08:17:16+02:00\",\n            \"totalTime\": \"PT20M\",\n            \"cookTime\": \"PT20M\",\n            \"recipeInstructions\": [\n                {\n                    \"@type\": \"HowToStep\",\n                    \"text\": \"Kokoschips in einer Pfanne ohne Fett anrösten, auf einem Küchenpapier abkühlen lassen. Mango mit einem Sparschäler schälen und links und rechts entlang des großen Kerns das Fruchtfleisch wegschneiden. Übrige Mango von dem Kern schneiden. Alternativ gibt es mittlerweile auch Mango aus dem Tiefkühlregal. Banane schälen und in Scheiben schneiden.\",\n                    \"url\": \"/rezepte/mango-smoothie-bowl-frisch-gesund-fruehstuecken#schritt-1\",\n                    \"image\": \"https://www.einfachbacken.de/sites/einfachbacken.de/files/styles/16_9/public/2019-08/mango_smoothie_bowl_26961.jpg?h=4521fff0\u0026itok=OO0aE-b3\"\n                },\n                {\n                    \"@type\": \"HowToStep\",\n                    \"text\": \"¼ der Mango in kleine Würfel schneiden und zum Garnieren beiseite stellen. Restliche Mango, Banane und Sojajoghurt fein pürieren. Für heiße Tage kannst du die Früchte gerne vorher einfrieren.\",\n                    \"url\": \"/rezepte/mango-smoothie-bowl-frisch-gesund-fruehstuecken#schritt-2\"\n                },\n                {\n                    \"@type\": \"HowToStep\",\n                    \"text\": \"Püree gleichmäßig auf zwei Schüsseln (ca. 250 ml) verteilen. Kiwi schälen, halbieren und in Scheiben schneiden. Kurz vor dem Servieren mit den beiseite gestellten Mangowürfeln, Kiwi, Kokoschips und je 1 EL Chiasamen garnieren. Eine Maracuja halbieren und mit einem Teelöffel das Fruchtfleisch direkt auf die Bowl verteilen.\",\n                    \"url\": \"/rezepte/mango-smoothie-bowl-frisch-gesund-fruehstuecken#schritt-3\"\n                }\n            ],\n            \"recipeIngredient\": [\n                \"2 EL Kokoschip\",\n                \"300 g Mango (ca. 2 reife Mangos)\",\n                \"1 Banane\",\n                \"200 g Sojajoghurt mit Kokos\",\n                \"2 EL Chia-Samen\",\n                \"1 Kiwi\",\n                \"1 Maracuja\"\n            ],\n            \"publisher\": {\n                \"@type\": \"Organization\",\n                \"name\": \"einfach backen\",\n                \"url\": \"https://www.einfachbacken.de\",\n                \"logo\": {\n                    \"@type\": \"ImageObject\",\n                    \"url\": \"https://www.einfachbacken.de/images/logo-einfachbacken-60.jpg\",\n                    \"width\": \"146\",\n                    \"height\": \"60\"\n                },\n                \"address\": {\n                    \"@type\": \"PostalAddress\",\n                    \"addressCountry\": \"DE\",\n                    \"addressLocality\": \"Offenburg\",\n                    \"postalCode\": \"77652\",\n                    \"streetAddress\": \"Hubert Burda Platz 1\"\n                }\n            },\n            \"recipeCategory\": \"Rezepte\",\n            \"author\": {\n                \"@type\": \"Person\",\n                \"name\": \"Siggi Schuppler\",\n                \"url\": \"https://www.einfachbacken.de/autoren/siggi-schuppler\"\n            },\n            \"image\": [\n                {\n                    \"@type\": \"ImageObject\",\n                    \"representativeOfPage\": true,\n                    \"url\": \"https://www.einfachbacken.de/sites/einfachbacken.de/files/styles/16_9/public/2019-08/mango_smoothie_bowl_27337.jpg?h=4521fff0\u0026itok=LJ1mSY7P\",\n                    \"width\": 1200,\n                    \"height\": 675\n                }\n            ],\n            \"nutrition\": {\n                \"@type\": \"NutritionInformation\",\n                \"servingSize\": \"Portion\"\n            },\n            \"aggregateRating\": {\n                \"@type\": \"AggregateRating\",\n                \"ratingValue\": 5,\n                \"ratingCount\": 1,\n                \"bestRating\": 5,\n                \"worstRating\": 1\n            }\n        }\n    ]\n}\u003c/script\u003e\n"])</script><script>self.__next_f.push([1,"5:[\"$\",\"$L2c\",null,{\"data\":{\"__typename\":\"Query\",\"page\":{\"id\":2796,\"entity\":\"node\",\"published\":true,\"url\":\"/rezepte/mango-smoothie-bowl-frisch-gesund-fruehstuecken\",\"name\":\"Mango-Smoothie-Bowl\",\"created\":\"2019-08-12T10:26:12+0200\",\"introText\":\"So wird es schon beim Frühstück fruchtig und gesund! Frische Mango, cremiger Sojajoghurt und Chia-Samen sorgen für den perfekten Start in den Tag.\",\"publishedAt\":\"2022-08-10T09:16:54+0200\",\"plannedPublishingDate\":null,\"alsoGoesWith\":null,\"author\":{\"id\":601,\"name\":\"Siggi\",\"url\":\"/autoren/siggi-schuppler\",\"jobTitle\
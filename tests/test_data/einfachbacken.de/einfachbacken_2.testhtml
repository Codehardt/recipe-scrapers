2/public/2026-04/2025_Kommunion-Torte_Aufmacher.jpg?h=86e80ecd\u0026itok=KjOqQuUj\",\"width\":576,\"height\":432,\"__typename\":\"ImageDerivative\"},\"sm_2x\":{\"src\":\"https://www.einfachbacken.de/sites/einfachbacken.de/files/styles/1152_864/public/2026-04/2025_Kommunion-Torte_Aufmacher.jpg?h=86e80ecd\u0026itok=-RDD3tL1\",\"width\":1152,\"height\":864,\"__typename\":\"ImageDerivative\"}},\"imageCaption\":null,\"imageMobile\":null,\"imageTablet\":null,\"imageVertical\":null,\"link\":null,\"showDividerBelow\":false,\"__typename\":\"ParagraphImage\"},\"rating\":{\"rating\":null,\"__typename\":\"FieldTypeVotingApi\"},\"totalComments\":0,\"bookmarkCount\":136,\"cookingTotalTime\":130,\"preparationTime\":null,\"difficultyLevel\":{\"name\":\"Anspruchsvoll\",\"__typename\":\"TermDifficulty\"},\"campaign\":null,\"aufmacherVideo\":null,\"author\":{\"id\":7246,\"name\":\"Lie-Hong\",\"photo\":{\"src\":\"https://www.einfachbacken.de/sites/einfachbacken.de/files/2025-07/Autorenpotrait%20Lie%20Hong_Zuschnitt.jpg\",\"width\":1179,\"name\":\"2025 / Autorenportrait Lie-Hong\",\"source\":null,\"height\":1180,\"alt\":\"Autorenportrait Lie-Hong\",\"description\":null,\"copyright\":null,\"digitalSourceType\":null,\"title\":\"Autorenportrait Lie-Hong\",\"__typename\":\"MediaImage\",\"thumbnail\":{\"src\":\"https://www.einfachbacken.de/sites/einfachbacken.de/files/styles/author_thumbnail/public/2025-07/Autorenpotrait%20Lie%20Hong_Zuschnitt.jpg?itok=Y44EXSgf\",\"width\":50,\"height\":50,\"__typename\":\"ImageDerivative\"}},\"url\":\"/autoren/lie-hong-ngai\",\"__typename\":\"NodeAuthorProfile\"},\"showEatbetterBranding\":false,\"numberPortions\":1,\"__typename\":\"NodeRecipe\"},{\"id\":5174,\"name\":\"Pancakes für Babys \",\"url\":\"/rezepte/pancakes-fuer-babys-so-lecker-und-gesund\",\"kicker\":\"so fluffig\",\"introText\":\"Pancakes für Babys ohne Zucker sind fluffig, süß und so saftig. Mit Haferflocken und Zimt werden die selbst gemachten Mini-Pfannkuchen lecker und aromatisch. Das Rezep